		DisplayName = "Redcoat",
		Team = "Red",
		Health = 100,
		Speed = 7,
		Attack = "Musket",
		Damage = 25,
		Range = 85,
		Reload = 5.5,
		Spread = 5,
		AimTime = 1.0,
		Bounty = 10,
		CoatColor = Color3.fromRGB(178, 34, 34),
		Hat = "Tricorne",
	},
	LightInfantry = {
		DisplayName = "Light Infantry",
		Team = "Red",
		Health = 70,
		Speed = 13,
		Attack = "Musket",
		Damage = 20,
		Range = 70,
		Reload = 4.0,
		Spread = 6,
		AimTime = 0.8,
		Bounty = 12,
		CoatColor = Color3.fromRGB(200, 60, 50),
		Hat = "Cap",
	},
	Grenadier = {
		DisplayName = "Grenadier",
		Team = "Red",
		Health = 200,
		Speed = 6,
		Attack = "Grenade",
		Damage = 45,
		Range = 55,
		Reload = 6.0,
		Spread = 0,
		AimTime = 0.6,
		Bounty = 25,
		CoatColor = Color3.fromRGB(150, 20, 25),
		Hat = "Bearskin",
		Scale = 1.15,
	},
	Officer = {
		DisplayName = "Officer",
		Team = "Red",
		Health = 130,
		Speed = 8,
		Attack = "Musket",
		Damage = 30,
		Range = 60,
		Reload = 3.0,
		Spread = 4,
		AimTime = 0.6,
		Bounty = 40,
		CoatColor = Color3.fromRGB(220, 20, 40),
		Hat = "Tricorne",
	},
	Dragoon = {
		DisplayName = "Dragoon",
		Team = "Red",
		Health = 160,
		Speed = 22,
		Attack = "Sabre",
		Damage = 35,
		Range = 5,
		Reload = 1.4,
		Spread = 0,
		AimTime = 0,
		Bounty = 30,
		CoatColor = Color3.fromRGB(170, 30, 30),
		Hat = "Helmet",
	},
	Cannon = {
		DisplayName = "Field Gun",
		Team = "Red",
		Health = 350,
		Speed = 0,
		Attack = "Cannon",
		Damage = 80,
		Range = 400,
		Reload = 9.0,
		Spread = 3,
		AimTime = 1.6,
		Bounty = 60,
		CoatColor = Color3.fromRGB(178, 34, 34),
		Hat = "None",
	},
	Militia = {
		DisplayName = "Minuteman",
		Team = "Blue",
		Health = 100,
		Speed = 14,
		Attack = "Musket",
		Damage = 50,
		Range = 90,
		Reload = 4.5,
		Spread = 4,
		AimTime = 0.5,
		Bounty = 0,
		CoatColor = Color3.fromRGB(32, 45, 100), -- Continental blue
		Hat = "Tricorne",
	},
	-- Boss: a mounted British general every Config.Boss.Every waves.
	General = {
		DisplayName = "General",
		Team = "Red",
		Health = 1500,
		Speed = 9,
		Attack = "Musket", -- fires a brace of pistols (3 quick shots)
		Damage = 22,
		Range = 70,
